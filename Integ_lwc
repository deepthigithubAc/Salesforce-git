Step 4: Use Queueable Apex (Best Practice)
public class OpportunityQueueable
implements Queueable, Database.AllowsCallouts{
    private Id oppId;
    public OpportunityQueueable(Id oppId){
        this.oppId = oppId;
    }
    public void execute(QueueableContext qc){
        Opportunity opp = [
            SELECT Id, Amount
            FROM Opportunity
            WHERE Id = :oppId
        ];
        SAPService.sendOpportunity(opp);
    }
}
